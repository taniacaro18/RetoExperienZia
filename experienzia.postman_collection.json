{
  "info": {
    "_postman_id": "experienzia-collection-v1",
    "name": "ExperienZia API",
    "description": "Colección completa de la API REST de ExperienZia. Cubre HU-001 a HU-024.\n\nCómo usar:\n1. Levanta el backend: `./mvnw.cmd spring-boot:run`.\n2. Importa esta colección en Postman.\n3. Importa también el environment `experienzia.postman_environment.json` (variables baseUrl, idAdmin, idOrganizador, idAsistente, idStaff, idEvento, idInscripcion, idPago, idStaffEvento, codigoQR, codigoCertificado).\n4. Ejecuta los requests en orden: registro → login → crear evento → aprobar → pago → activar → inscribir → check-in → certificado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Salud",
      "item": [
        {
          "name": "GET actuator/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "GET swagger-ui",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/swagger-ui.html",
              "host": ["{{baseUrl}}"],
              "path": ["swagger-ui.html"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Usuarios (HU-001/002/003/005/006)",
      "item": [
        {
          "name": "Registrar ASISTENTE (HU-001)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Asistente\",\n  \"email\": \"ana.asistente@experienzia.com\",\n  \"password\": \"ana1234\",\n  \"telefono\": \"3001112233\",\n  \"tipoDocumento\": \"CC\",\n  \"numeroDocumento\": \"1001\",\n  \"tipo\": \"ASISTENTE\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/usuarios/registro", "host": ["{{baseUrl}}"], "path": ["api","usuarios","registro"]}
          }
        },
        {
          "name": "Registrar ORGANIZADOR (HU-002)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Oscar Organizador\",\n  \"email\": \"oscar.org@experienzia.com\",\n  \"password\": \"oscar1234\",\n  \"telefono\": \"3001112244\",\n  \"tipoDocumento\": \"CC\",\n  \"numeroDocumento\": \"2001\",\n  \"tipo\": \"ORGANIZADOR\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/usuarios/registro", "host": ["{{baseUrl}}"], "path": ["api","usuarios","registro"]}
          }
        },
        {
          "name": "Login (HU-003)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.asistente@experienzia.com\",\n  \"password\": \"ana1234\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/usuarios/login", "host": ["{{baseUrl}}"], "path": ["api","usuarios","login"]}
          }
        },
        {
          "name": "Crear STAFF por organizador (HU-004)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizadorId\": {{idOrganizador}},\n  \"nombre\": \"Sara Staff\",\n  \"email\": \"sara.staff@experienzia.com\",\n  \"password\": \"sara1234\",\n  \"telefono\": \"3001112255\",\n  \"tipoDocumento\": \"CC\",\n  \"numeroDocumento\": \"3001\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/usuarios/staff", "host": ["{{baseUrl}}"], "path": ["api","usuarios","staff"]}
          }
        },
        {
          "name": "Recuperar contraseña (HU-005)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.asistente@experienzia.com\",\n  \"numeroDocumento\": \"1001\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/usuarios/recuperar", "host": ["{{baseUrl}}"], "path": ["api","usuarios","recuperar"]}
          }
        },
        {
          "name": "Reenviar credenciales a un usuario",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/{{idAsistente}}/reenviar-credenciales?actorId={{idOrganizador}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","usuarios","{{idAsistente}}","reenviar-credenciales"],
              "query": [{"key": "actorId", "value": "{{idOrganizador}}"}]
            }
          },
          "description": "Resetea la contraseña al número de documento (o genera una temporal) y notifica al usuario."
        },
        {
          "name": "Editar perfil (HU-006)",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana A. Modificado\",\n  \"telefono\": \"3009999999\",\n  \"nuevaPassword\": \"ana5678\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/usuarios/{{idAsistente}}", "host": ["{{baseUrl}}"], "path": ["api","usuarios","{{idAsistente}}"]}
          }
        },
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/usuarios", "host": ["{{baseUrl}}"], "path": ["api","usuarios"]}
          }
        },
        {
          "name": "Buscar usuarios (filtros)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/buscar?rol=ORGANIZADOR&estado=PENDIENTE",
              "host": ["{{baseUrl}}"],
              "path": ["api","usuarios","buscar"],
              "query": [
                {"key": "rol", "value": "ORGANIZADOR"},
                {"key": "estado", "value": "PENDIENTE"}
              ]
            }
          }
        },
        {
          "name": "Obtener usuario",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/usuarios/{{idAsistente}}", "host": ["{{baseUrl}}"], "path": ["api","usuarios","{{idAsistente}}"]}
          }
        }
      ]
    },
    {
      "name": "2. Admin (HU-018/019)",
      "item": [
        {
          "name": "Aprobar organizador (HU-019/HU-002)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/admin/usuarios/{{idOrganizador}}/aprobar?adminId={{idAdmin}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","admin","usuarios","{{idOrganizador}}","aprobar"],
              "query": [{"key": "adminId", "value": "{{idAdmin}}"}]
            }
          }
        },
        {
          "name": "Rechazar organizador (HU-002)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/admin/usuarios/{{idOrganizador}}/rechazar?adminId={{idAdmin}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","admin","usuarios","{{idOrganizador}}","rechazar"],
              "query": [{"key": "adminId", "value": "{{idAdmin}}"}]
            }
          }
        },
        {
          "name": "Desactivar usuario (HU-019)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/admin/usuarios/{{idAsistente}}/desactivar?adminId={{idAdmin}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","admin","usuarios","{{idAsistente}}","desactivar"],
              "query": [{"key": "adminId", "value": "{{idAdmin}}"}]
            }
          }
        },
        {
          "name": "Reactivar usuario (HU-019)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/admin/usuarios/{{idAsistente}}/reactivar?adminId={{idAdmin}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","admin","usuarios","{{idAsistente}}","reactivar"],
              "query": [{"key": "adminId", "value": "{{idAdmin}}"}]
            }
          }
        },
        {
          "name": "Cambiar rol (HU-018)",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rol\": \"ORGANIZADOR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/usuarios/{{idAsistente}}/rol?adminId={{idAdmin}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","admin","usuarios","{{idAsistente}}","rol"],
              "query": [{"key": "adminId", "value": "{{idAdmin}}"}]
            }
          }
        }
      ]
    },
    {
      "name": "3. Organizador → Staff (HU-004)",
      "item": [
        {
          "name": "Desactivar staff (organizador)",
          "request": {
            "method": "PUT",
            "url": {"raw": "{{baseUrl}}/api/organizadores/{{idOrganizador}}/staff/{{idStaff}}/desactivar", "host": ["{{baseUrl}}"], "path": ["api","organizadores","{{idOrganizador}}","staff","{{idStaff}}","desactivar"]}
          }
        },
        {
          "name": "Reactivar staff (organizador)",
          "request": {
            "method": "PUT",
            "url": {"raw": "{{baseUrl}}/api/organizadores/{{idOrganizador}}/staff/{{idStaff}}/reactivar", "host": ["{{baseUrl}}"], "path": ["api","organizadores","{{idOrganizador}}","staff","{{idStaff}}","reactivar"]}
          }
        }
      ]
    },
    {
      "name": "4. Eventos (HU-007/008/009/010/011/020)",
      "item": [
        {
          "name": "Crear evento (HU-007)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tech Summit 2026\",\n  \"descripcion\": \"Conferencia de tecnología y desarrollo de software.\",\n  \"fecha\": \"2026-08-15T10:00:00\",\n  \"ubicacion\": \"Salón Principal\",\n  \"aforoMaximo\": 100,\n  \"costo\": 50000,\n  \"tipoEvento\": \"PUBLICO\",\n  \"organizadorId\": {{idOrganizador}},\n  \"categoria\": \"Tecnología\",\n  \"duracionHoras\": 6\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/eventos", "host": ["{{baseUrl}}"], "path": ["api","eventos"]}
          }
        },
        {
          "name": "Editar evento (HU-008) → vuelve a PENDIENTE",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tech Summit 2026 (actualizado)\",\n  \"descripcion\": \"Conferencia ampliada con talleres prácticos.\",\n  \"fecha\": \"2026-08-15T09:00:00\",\n  \"ubicacion\": \"Salón Principal y Salón Anexo\",\n  \"aforoMaximo\": 150,\n  \"costo\": 60000,\n  \"tipoEvento\": \"PUBLICO\",\n  \"organizadorId\": {{idOrganizador}},\n  \"categoria\": \"Tecnología\",\n  \"duracionHoras\": 8\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/eventos/{{idEvento}}", "host": ["{{baseUrl}}"], "path": ["api","eventos","{{idEvento}}"]}
          }
        },
        {
          "name": "Aprobar evento (HU-020)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/eventos/{{idEvento}}/aprobar?adminId={{idAdmin}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","eventos","{{idEvento}}","aprobar"],
              "query": [{"key": "adminId", "value": "{{idAdmin}}"}]
            }
          }
        },
        {
          "name": "Rechazar evento con motivo (HU-020)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"La fecha solicitada no está disponible en el salón principal.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/eventos/{{idEvento}}/rechazar?adminId={{idAdmin}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","eventos","{{idEvento}}","rechazar"],
              "query": [{"key": "adminId", "value": "{{idAdmin}}"}]
            }
          }
        },
        {
          "name": "Cancelar evento con motivo (HU-009)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizadorId\": {{idOrganizador}},\n  \"motivo\": \"Fuerza mayor: indisponibilidad del recinto.\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/eventos/{{idEvento}}/cancelar", "host": ["{{baseUrl}}"], "path": ["api","eventos","{{idEvento}}","cancelar"]}
          }
        },
        {
          "name": "Listar todos",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/eventos", "host": ["{{baseUrl}}"], "path": ["api","eventos"]}}
        },
        {
          "name": "Obtener evento por id",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/eventos/{{idEvento}}", "host": ["{{baseUrl}}"], "path": ["api","eventos","{{idEvento}}"]}}
        },
        {
          "name": "Catálogo público activo (HU-011)",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/eventos/catalogo/publicos", "host": ["{{baseUrl}}"], "path": ["api","eventos","catalogo","publicos"]}}
        },
        {
          "name": "Mis eventos (HU-010)",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/eventos/organizador/{{idOrganizador}}", "host": ["{{baseUrl}}"], "path": ["api","eventos","organizador","{{idOrganizador}}"]}}
        },
        {
          "name": "Buscar con filtros (HU-011)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/eventos/buscar?nombre=Tech&categoria=Tecnología&tipoEvento=PUBLICO&estado=ACTIVO",
              "host": ["{{baseUrl}}"],
              "path": ["api","eventos","buscar"],
              "query": [
                {"key": "nombre", "value": "Tech"},
                {"key": "categoria", "value": "Tecnología"},
                {"key": "tipoEvento", "value": "PUBLICO"},
                {"key": "estado", "value": "ACTIVO"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Pagos (HU-014/021)",
      "item": [
        {
          "name": "Registrar pago + comprobante (HU-014)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "inscripcionId", "value": "{{idInscripcion}}", "type": "text"},
                {"key": "archivo", "type": "file", "src": []}
              ]
            },
            "url": {"raw": "{{baseUrl}}/api/pagos", "host": ["{{baseUrl}}"], "path": ["api","pagos"]}
          }
        },
        {
          "name": "Aprobar pago (HU-021) → activa evento",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/pagos/{{idPago}}/aprobar?aprobadorId={{idAdmin}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","pagos","{{idPago}}","aprobar"],
              "query": [{"key": "aprobadorId", "value": "{{idAdmin}}"}]
            }
          }
        },
        {
          "name": "Rechazar pago con motivo (HU-021)",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Comprobante ilegible.\",\n  \"aprobadorId\": {{idAdmin}}\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/pagos/{{idPago}}/rechazar", "host": ["{{baseUrl}}"], "path": ["api","pagos","{{idPago}}","rechazar"]}
          }
        },
        {
          "name": "Listar pendientes",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/pagos/pendientes", "host": ["{{baseUrl}}"], "path": ["api","pagos","pendientes"]}}
        },
        {
          "name": "Historial de pagos (quién aprobó/rechazó y cuándo)",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/pagos", "host": ["{{baseUrl}}"], "path": ["api","pagos"]}}
        }
      ]
    },
    {
      "name": "6. Inscripciones, Check-in/out, Carga (HU-012/013/015/016/017)",
      "item": [
        {
          "name": "Inscribir asistente (HU-011/012)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": {{idAsistente}},\n  \"eventoId\": {{idEvento}}\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/inscripciones", "host": ["{{baseUrl}}"], "path": ["api","inscripciones"]}
          }
        },
        {
          "name": "Cancelar inscripción",
          "request": {
            "method": "PUT",
            "url": {"raw": "{{baseUrl}}/api/inscripciones/{{idInscripcion}}/cancelar", "host": ["{{baseUrl}}"], "path": ["api","inscripciones","{{idInscripcion}}","cancelar"]}
          }
        },
        {
          "name": "Listar inscripciones por evento",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/inscripciones/evento/{{idEvento}}", "host": ["{{baseUrl}}"], "path": ["api","inscripciones","evento","{{idEvento}}"]}}
        },
        {
          "name": "Mis inscripciones (HU-012)",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/inscripciones/usuario/{{idAsistente}}", "host": ["{{baseUrl}}"], "path": ["api","inscripciones","usuario","{{idAsistente}}"]}}
        },
        {
          "name": "Check-in manual (HU-016)",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffUsuarioId\": {{idStaff}}\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/inscripciones/{{idInscripcion}}/check-in", "host": ["{{baseUrl}}"], "path": ["api","inscripciones","{{idInscripcion}}","check-in"]}
          }
        },
        {
          "name": "Check-out manual (HU-017)",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffUsuarioId\": {{idStaff}}\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/inscripciones/{{idInscripcion}}/check-out", "host": ["{{baseUrl}}"], "path": ["api","inscripciones","{{idInscripcion}}","check-out"]}
          }
        },
        {
          "name": "Check-in por QR (HU-015)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffUsuarioId\": {{idStaff}},\n  \"codigoQR\": \"{{codigoQR}}\",\n  \"eventoId\": {{idEvento}}\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/inscripciones/check-in/qr", "host": ["{{baseUrl}}"], "path": ["api","inscripciones","check-in","qr"]}
          }
        },
        {
          "name": "Check-out por QR (HU-017)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffUsuarioId\": {{idStaff}},\n  \"codigoQR\": \"{{codigoQR}}\",\n  \"eventoId\": {{idEvento}}\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/inscripciones/check-out/qr", "host": ["{{baseUrl}}"], "path": ["api","inscripciones","check-out","qr"]}
          }
        },
        {
          "name": "Carga manual de asistentes (HU-013)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizadorId\": {{idOrganizador}},\n  \"filas\": [\n    {\"nombre\": \"Invitado Uno\", \"email\": \"inv1@experienzia.com\", \"telefono\": \"3000000001\", \"tipoDocumento\": \"CC\", \"numeroDocumento\": \"9001\"},\n    {\"nombre\": \"Invitado Dos\", \"email\": \"inv2@experienzia.com\", \"telefono\": \"3000000002\", \"tipoDocumento\": \"CC\", \"numeroDocumento\": \"9002\"}\n  ]\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/eventos/{{idEvento}}/asistentes/carga-manual", "host": ["{{baseUrl}}"], "path": ["api","eventos","{{idEvento}}","asistentes","carga-manual"]}
          }
        },
        {
          "name": "Carga CSV (HU-013)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "organizadorId", "value": "{{idOrganizador}}", "type": "text"},
                {"key": "archivo", "type": "file", "src": []}
              ]
            },
            "url": {"raw": "{{baseUrl}}/api/eventos/{{idEvento}}/asistentes/carga-csv", "host": ["{{baseUrl}}"], "path": ["api","eventos","{{idEvento}}","asistentes","carga-csv"]}
          },
          "description": "El archivo CSV debe tener cabecera: nombre,email,telefono,tipoDocumento,numeroDocumento"
        },
        {
          "name": "Asignar staff a evento (HU-004) — con funcion",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizadorId\": {{idOrganizador}},\n  \"staffUsuarioId\": {{idStaff}},\n  \"funcion\": \"CHECK_IN_QR\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/eventos/{{idEvento}}/staff/asignacion", "host": ["{{baseUrl}}"], "path": ["api","eventos","{{idEvento}}","staff","asignacion"]}
          },
          "description": "funcion: CHECK_IN_QR | CHECK_IN_MANUAL | REGISTRO_SALIDA | GENERAL"
        },
        {
          "name": "Cambiar función del staff",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"funcion\": \"REGISTRO_SALIDA\"\n}"
